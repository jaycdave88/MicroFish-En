# ===== LLM API Configuration =====
# Supports any OpenAI-compatible API (Ollama, LM Studio, vLLM, llama.cpp, etc.)

# --- Ollama (recommended for local) ---
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=llama3.1:8b

# --- LM Studio ---
# LLM_API_KEY=lm-studio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL_NAME=your-loaded-model

# --- vLLM ---
# LLM_API_KEY=vllm
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL_NAME=your-model

# --- Cloud API (OpenAI, Qwen, etc.) ---
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini

# ===== Zep Memory Graph Configuration =====
# Free monthly quota is sufficient for simple usage: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Development Configuration =====
# Debug mode enables hot-reload and verbose error responses
FLASK_DEBUG=True

# ===== Security Configuration =====
# CORS: By default, all localhost origins are allowed for local dev.
# Set this to restrict origins in production (comma-separated).
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Flask secret key (auto-generated if not set)
# SECRET_KEY=your-secret-key-here

# ===== Accelerated LLM Configuration (Optional) =====
# Use a faster/larger model for specific tasks (e.g. report generation)
# If not set, the primary LLM config above is used for everything.
# LLM_BOOST_API_KEY=ollama
# LLM_BOOST_BASE_URL=http://localhost:11434/v1
# LLM_BOOST_MODEL_NAME=llama3.1:70b
